{
  "name": "regalvest-2",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @regalvest/web --filter @regalvest/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @regalvest/api test",
    "db:generate": "pnpm --filter @regalvest/api db:generate",
    "db:migrate": "pnpm --filter @regalvest/api db:migrate",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,mjs}\" \"*.{json,yaml,md}\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
